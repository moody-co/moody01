generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================= ENUMS =================
enum VenueCategory {
  CLUB
  BAR
  RESTAURANT
  LOUNGE
  OTHER
}

enum Crowded {
  EMPTY
  MEDIUM
  FULL
}

enum Vibe {
  LOW
  OK
  LIVELY
}

enum YesNo {
  YES
  NO
}

enum TicketStatus {
  ACTIVE
  CONFIRMED
  CANCELLED
  USED
  REFUNDED // Adicionado status de reembolso para escalabilidade
}

// ================= MODELS =================

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String?  @unique
  name         String
  passwordHash String?
  avatarUrl    String?
  bio          String?
  city         String?
  state        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  checkins      Checkin[]
  reviews       Review[]
  tickets       Ticket[]
  presences     PresenceVerification[]
  payments      Payment[]

  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ip               String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Venue {
  id           String        @id @default(cuid())
  name         String
  subtitle     String?
  category     VenueCategory
  addressLine  String?
  city         String?
  state        String?
  country      String?       @default("BR")
  lat          Decimal?      @db.Decimal(10, 7)
  lng          Decimal?      @db.Decimal(10, 7)
  heroImageUrl String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  events   Event[]
  checkins Checkin[]
  reviews  Review[]

  @@map("venues")
}

model Event {
  id         String    @id @default(cuid())
  venueId    String
  title      String
  city       String?
  area       String?
  imageUrl   String?
  promoTitle String?
  promoText  String?
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  venue     Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  presences PresenceVerification[]
  checkins  Checkin[]
  tickets   Ticket[]
  payments  Payment[] // Adicionado para fechar caixa financeiro do evento

  @@map("events")
}

model PresenceVerification {
  id         String   @id @default(cuid())
  userId     String
  eventId    String
  verifiedAt DateTime
  unlockAt   DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, verifiedAt])
  @@map("presence_verifications")
}

model Checkin {
  id          String   @id @default(cuid())
  userId      String
  venueId     String
  eventId     String?
  crowded     Crowded
  vibe        Vibe
  promoActive YesNo
  worthIt     YesNo
  photoUrl    String?
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([venueId, createdAt])
  @@index([eventId, createdAt])
  @@index([userId, createdAt])
  @@map("checkins")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  venueId   String
  rating    Int?
  content   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  eventId   String
  status    TicketStatus
  code      String       @unique
  qrPayload String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payment Payment?  // Relação 1 para 1 (Um ingresso tem um pagamento ligado)

  @@map("tickets")
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  eventId     String?  // Novo: Para saber de qual evento é esse dinheiro
  ticketId    String?  @unique // Novo: Link direto para o ingresso gerado
  provider    String   @default("stripe")
  status      String
  amountCents Int
  currency    String   @default("BRL")
  providerRef String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@map("payments")
}